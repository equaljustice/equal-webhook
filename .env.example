# Copy to .env and fill in values. Never commit .env.

PORT=8080
NODE_ENV=development

# MongoDB
MONGO_URI=
DB_NAME=equalJustice

# Auth
JWT_SECRET=
AUTH_SECRET_KEY=
GUEST_JWT_SECRET=

# Guest sessions — optional
# Default (no REDIS_URL): in-memory store in dev AND production (current setup).
# When you add Redis later, set REDIS_URL and guest sessions use Redis automatically.
# REDIS_URL=redis://127.0.0.1:6379
#
# Force guest chat to fail without Redis (use after Redis is ready):
# GUEST_REQUIRE_REDIS=true

# Guest signup offer after language selection (default on; set false to disable)
# GUEST_SIGNUP_OFFER_ENABLED=true

# Flow orchestrator — deterministic Q&A for assistants listed in assets/flows/manifest.json
# FLOW_ORCHESTRATOR_ENABLED=true

# Gemini context caching — caches instruction .txt per assistant (default on when GEMINI_API_KEY set)
# GEMINI_CONTEXT_CACHE_ENABLED=true
# How long Gemini keeps the cached instruction block (storage is billed for TTL duration)
# Default: 86400 (24 hours). For stable prod prompts use e.g. 604800 (7 days).
# GEMINI_CACHE_TTL_SEC=86400
# GEMINI_TRIM_HISTORY_TURNS=2

# Optional global Gemini generation overrides (used when admin DB / assistant config omit a value)
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TEMPERATURE=0.1
# GEMINI_TOP_K=10
# GEMINI_TOP_P=0.5

# OpenAI / Gemini / payments / prompts — see existing .env on your machine
