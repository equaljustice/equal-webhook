# Copy to .env and fill in values. Never commit .env.

PORT=8080
NODE_ENV=development

# MongoDB
MONGO_URI=
DB_NAME=equalJustice

# Auth
JWT_SECRET=
AUTH_SECRET_KEY=
GUEST_JWT_SECRET=

# Guest sessions — optional
# Default (no REDIS_URL): in-memory store in dev AND production (current setup).
# When you add Redis later, set REDIS_URL and guest sessions use Redis automatically.
# REDIS_URL=redis://127.0.0.1:6379
#
# Force guest chat to fail without Redis (use after Redis is ready):
# GUEST_REQUIRE_REDIS=true

# Guest signup offer after language selection (default on; set false to disable)
# GUEST_SIGNUP_OFFER_ENABLED=true

# Flow orchestrator — deterministic Q&A for assistants listed in assets/flows/manifest.json
# FLOW_ORCHESTRATOR_ENABLED=true

# OpenAI / Gemini / payments / prompts — see existing .env on your machine
